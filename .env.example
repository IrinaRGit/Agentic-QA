# =============================================================================
# Run tests — required to clone and run Playwright
# =============================================================================

# BuddyTime test site origin (no path); Playwright resolves /login against this host
APP_URL=https://test.buddytime.ca/

# Main test family login; used by auth.setup to write playwright/.auth/user.json
APP_USER_EMAIL=user@example.com

# Password for APP_USER_EMAIL
APP_USER_PASSWORD=your-main-user-password

# Second parent/family login; tests that need two parents skip if unset
APP_ALT_USER_EMAIL=alt-user@example.com

# Password for APP_ALT_USER_EMAIL
APP_ALT_USER_PASSWORD=your-alt-user-password

# =============================================================================
# Agent / CI setup — not needed for npx playwright test alone
# =============================================================================

# Cursor headless agent (.github/workflows/test-generation.yml)
CURSOR_API_KEY=your-cursor-api-key

# Atlassian Cloud site URL (e.g. https://your-site.atlassian.net)
ATLASSIAN_BASE_URL=https://example.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com

# Atlassian API token for backlog queries and labels
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira project key for stories and bugs
JIRA_PROJECT_KEY=AQPBT

# Confluence space key for feature pages
CONFLUENCE_SPACE_KEY=AQPBT
