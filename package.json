{
  "name": "agentic-qa",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:setup": "playwright test --project=setup",
    "test:smoke": "playwright test --grep '@smoke'",
    "test:sanity": "playwright test --grep '@sanity'",
    "test:regression": "playwright test --grep '@regression'",
    "test:api": "playwright test --grep '@api'",
    "test:e2e": "playwright test --grep '@e2e'",
    "test:destructive": "playwright test --grep '@destructive' --workers=1",
    "playwright:install": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrinaRGit/Agentic-QA.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IrinaRGit/Agentic-QA/issues"
  },
  "homepage": "https://github.com/IrinaRGit/Agentic-QA#readme",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "agent-browser": "^0.38.2",
    "dotenv": "^18.0.4"
  },
  "allowScripts": {
    "agent-browser@0.38.2": true
  }
}
